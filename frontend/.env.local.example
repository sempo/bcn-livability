# Geoapify geocoding — get a key at https://www.geoapify.com
VITE_GEOAPIFY_API_KEY=

# OpenTripPlanner 2 (local Docker backend)
VITE_OTP_URL=http://localhost:8080

# Departure time for route calculations (HH:MM:SS, next Monday in Madrid timezone)
VITE_OTP_DEPARTURE_TIME=09:00:00

# Transit modes for point-to-point routing (TRANSIT is broken in OTP2 v1 REST API)
VITE_OTP_TRANSIT_MODES=WALK,SUBWAY,BUS,TRAM,RAIL

# Number of transit route alternatives to evaluate (pick the fastest)
VITE_OTP_TRANSIT_ITINERARIES=3

# Anthropic API key for screenshot parsing (vision)
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-haiku-4-5

# Scoring: travel sub-index weights (walk / public transport / cycling / driving)
VITE_WEIGHT_WALK=4
VITE_WEIGHT_PT=3
VITE_WEIGHT_CYCLE=2
VITE_WEIGHT_CAR=1

# Scoring: travel time cap in minutes (beyond this = score 0 for that mode)
VITE_TRAVEL_CAP_MINUTES=60

# Walkability: distance-decay + per-category saturation (features 010 & 017). Each nearby service
# contributes exp(-distance/DECAY); contributions saturate per category (see serviceCategories.ts).
# Smaller DECAY = proximity matters more; RMAX = hard cutoff. Used by the pins; the building index is
# precomputed by scripts/building_access.py from WALK_DECAY_M / WALK_RMAX_M (same defaults) — rerun it after changing.
VITE_WALK_DECAY_M=400
VITE_WALK_RMAX_M=1500

# Scoring: composite score weights (travel index vs noise score vs walkability)
VITE_COMPOSITE_WEIGHT_TRAVEL=5
VITE_COMPOSITE_WEIGHT_NOISE=2
VITE_COMPOSITE_WEIGHT_WALKABILITY=3

# Climate-risk penalties (feature 036). Applied after the weighted mean:
#   score × (1 − strength/10 × floodRisk) × (1 − strength/10 × fireRisk) — safe buildings keep their score.
# Flood risk = the penalty of the most likely ACA river-flood zone the building touches (0–1).
VITE_FLOOD_PENALTY_T10=1       # 10-year zone (high probability)
VITE_FLOOD_PENALTY_T100=0.6    # 100-year zone (medium probability)
VITE_FLOOD_PENALTY_T500=0.25   # 500-year zone (low probability)
VITE_RISK_STRENGTH_FLOOD=5     # default slider strength 0–10
VITE_RISK_STRENGTH_FIRE=5      # default slider strength 0–10
VITE_RISK_STRENGTH_STREET=5    # default slider strength 0–10 (street flooding in heavy rain, feature 037)
# Street flooding risk (TODO-046): the water depth at the building's door (cm), weighted 0 at/below MIN and
# 1 at/above MAX (linear in between), then banded like the river zones (T10 penalty for the 10-year rain,
# T100 for the extra 100-year part).
VITE_STREET_FLOOD_MIN_CM=10
VITE_STREET_FLOOD_MAX_CM=50

# Livability conditions in real units (049): what is OK for the user. A building that meets a condition scores
# 100 on it, falling linearly to 0 over the fall-off; the index is the mean over the conditions that are on.
VITE_COND_NOISE_MAX_DB=65            # default: up to 65 dB outside the window
VITE_COND_PRICE_MAX_EUR_M2=4000      # default budget, €/m² (barri / municipality average sale price)
VITE_COND_CITY_CORE_MAX_MIN=30       # default: chosen places within 30 min walk
VITE_COND_WALK_MAX_MIN=10            # default: chosen services within 10 min walk
VITE_COND_LOCALS_MIN=7.5             # default: residents rate their barri at least 7.5 / 10 (042, flag)
VITE_COND_NOISE_FALLOFF_DB=10        # noise scores 0 this many dB over the limit
VITE_COND_PRICE_FALLOFF_PCT=25       # price scores 0 this many % over the budget
VITE_COND_MINUTES_FALLOFF_FACTOR=2   # a place / service scores 0 at this many times the minutes limit
VITE_COND_SATISF_FALLOFF=1           # residents' rating scores 0 this many points under the minimum

# Building age (TODO-047, weight off by default): the user ticks the eras of construction they like; a building
# of a liked era scores 100, any other 0, fading over BLUR years at the edges of a liked era.
VITE_AGE_ERA_BOUNDS=1900,1940,1980,2007   # era starts; the era names in buildingAge.ts are written for these
VITE_AGE_ERA_BLUR_YEARS=5
VITE_AGE_UNCERTAIN_YEAR=1900              # Catastro's date for old buildings of unknown year: counts for both eras
# Pipeline (scripts/build_neighbourhood_vibe.py → public/data/barri-vibe.json, rerun after changing):
#   VIBE_ESM_YEARS=2022-2026             survey years pooled per barri
#   VIBE_ESM_MIN_N=100                   fewer interviews = small sample (marked like missing data)
#   VIBE_ESM_SHRINK_K=100                (n·s + k·s_granbarri) / (n + k)

# Pipeline (scripts/climate_risk.py and scripts/building_exposure.py, read as plain env vars — changing
# them requires rerunning the scripts):
#   CLIMATE_RISK_DIR=data/climate-risk   inputs from scripts/fetch_climate_risk.py
#   FIRE_SEARCH_RADIUS_M=500             forest pixels considered around each building
#   FIRE_DECAY_M=150                     hazard contribution = class/10 × exp(−distance/FIRE_DECAY_M)
#   STREET_FLOOD_MIN_DEPTH_M=0.10        street-flooding map classes (view layer): lightest class from this depth…
#   STREET_FLOOD_MAX_DEPTH_M=0.50        …deepest class from this one

# TMB (Transports Metropolitans de Barcelona) — metro lines & stations
# Get credentials at https://developer.tmb.cat
VITE_TMB_APP_ID=
VITE_TMB_APP_KEY=

# Best zones (feature 038): up to N compact zones of the best res-9 H3 cells in the viewport (each cell
# scores the mean of the buildings in it),
# one Idealista search link each (Idealista's `shape` accepts a single hole-free polygon).
VITE_BEST_ZONES_TOP_PCT=15          # default strictness: zones from the top X% of visible cells
VITE_BEST_ZONES_MAX=3               # max number of zones
VITE_BEST_ZONES_TIE_RATIO=0.9       # also show areas with mass ≥ this × the last zone's (near-ties)…
VITE_BEST_ZONES_MAX_WITH_TIES=5     # …up to this many zones in total
VITE_BEST_ZONES_MIN_CELLS=5         # minimum zone size in res-9 cells (~0.5 km²); smaller cores are grown to it
VITE_BEST_ZONES_BUFFER_DEG=0.0006   # outward buffer before simplifying (~55 m) — smooths the cell zig-zag
VITE_BEST_ZONES_SIMPLIFY_TOL=0.001  # starting ring simplification tolerance (degrees, ~100 m)
VITE_BEST_ZONES_MAX_VERTICES=20     # hard cap on zone vertices — tolerance grows until met
VITE_IDEALISTA_MAX_URL_CHARS=900    # simplify each zone until its search URL fits (Idealista 400s on over-long shapes)

# Livability colour scale (TODO-032): fitted to the buildings in the visible part of the map.
VITE_SCORE_SCALE_TRIM_PCT=2         # the extreme X% of visible buildings on each side don't stretch the scale
VITE_SCORE_SCALE_MIN_SPAN=20        # the scale never spans fewer points (widened around its middle, within 0–100)

# Feature flags — set to 'true' to enable; omit or 'false' = disabled (public default)
# See docs/FEATURE_FLAGS.md for descriptions
VITE_FEATURE_ISOCHRONE=false
VITE_FEATURE_EXCLUSIONS=false
VITE_FEATURE_PINS=false
VITE_FEATURE_IDEALISTA_PRICES=false
VITE_FEATURE_SCREENSHOT=false
VITE_FEATURE_BEST_ZONES=false
VITE_FEATURE_FACADE_PHOTO=false
